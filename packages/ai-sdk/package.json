{
  "name": "@gnldev/ai-sdk",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "Vercel AI SDK `useChat` compatibility for @gnldev/durable agents: UI message stream conversion (with sentinel masking), journal→UIMessage history reconstruction, and a Hono chat route.",
  "keywords": [
    "ai",
    "agent",
    "llm",
    "typescript",
    "ai-sdk",
    "durable",
    "exactly-once",
    "usechat",
    "ui-stream"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gnldev/durable": "workspace:^"
  },
  "peerDependencies": {
    "ai": "^5.0.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@gnldev/durable": "workspace:*",
    "ai": "^5.0.0",
    "hono": "^4.6.0",
    "zod": "^3.25.0"
  },
  "author": "Karaca Yılmaz (https://gnl.dev)",
  "homepage": "https://gnl.dev",
  "bugs": {
    "url": "https://github.com/Karaca7/gnl-framework/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Karaca7/gnl-framework.git",
    "directory": "packages/ai-sdk"
  },
  "publishConfig": {
    "access": "public"
  }
