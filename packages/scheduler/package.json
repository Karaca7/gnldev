{
  "name": "@gnldev/scheduler",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "description": "Durable workflow scheduler on @gnldev/durable: cron/interval/at triggers, exactly-once fire (run-lock), backoff/retry. Time is data: the next fire time is resolved and frozen into the journal.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gnldev/workflow": "workspace:^"
  },
  "peerDependencies": {
    "@gnldev/durable": "workspace:^"
  },
  "devDependencies": {
    "@gnldev/durable": "workspace:*"
  },
  "author": "Karaca Yılmaz (https://gnl.dev)",
  "homepage": "https://gnl.dev",
  "bugs": {
    "url": "https://github.com/Karaca7/gnl-framework/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Karaca7/gnl-framework.git",
    "directory": "packages/scheduler"
  },
  "publishConfig": {
    "access": "public"
  }
}
