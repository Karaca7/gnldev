{
  "name": "@gnldev/scheduler",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "description": "Durable workflow scheduler on @gnldev/durable: cron/interval/at triggers, exactly-once fire (run-lock), backoff/retry. Zaman = veri (resolve-then-freeze).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gnldev/workflow": "workspace:^"
  },
  "peerDependencies": {
    "@gnldev/durable": "workspace:^"
  },
  "devDependencies": {
    "@gnldev/durable": "workspace:*"
  }
}
