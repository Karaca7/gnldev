{
  "name": "@gnldev/studio",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "Web inspector for @gnldev/durable runs: timeline, time-travel, approval queue.",
  "keywords": [
    "ai",
    "agent",
    "llm",
    "typescript",
    "ai-sdk",
    "durable",
    "exactly-once",
    "inspector",
    "observability",
    "playground"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ai": {
      "types": "./dist/ai-schema.d.ts",
      "default": "./dist/ai-schema.js"
    },
    "./workflow": {
      "types": "./dist/managed-workflow.d.ts",
      "default": "./dist/managed-workflow.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "gnl-studio": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gnldev/auth": "workspace:^",
    "@gnldev/durable": "workspace:^",
    "@gnldev/scheduler": "workspace:^",
    "@gnldev/studio-ui": "workspace:^",
    "@hono/node-server": "^1.19.17",
    "hono": "^4.13.2"
  },
  "peerDependencies": {
    "@gnldev/workflow": "workspace:^",
    "ai": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "@gnldev/workflow": {
      "optional": true
    }
  },
  "devDependencies": {
    "@gnldev/workflow": "workspace:*",
    "ai": "^7.0.0",
    "pg-mem": "^3.0.14",
    "zod": "^3.25.76"
  },
  "author": "Karaca Yılmaz (https://gnl.dev)",
  "homepage": "https://gnl.dev",
  "bugs": {
    "url": "https://github.com/Karaca7/gnldev/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Karaca7/gnldev.git",
    "directory": "packages/studio"
  },
  "publishConfig": {
    "access": "public"
  }
}
