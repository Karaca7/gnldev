{
  "name": "@gnldev/durable",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "Call-scoped exactly-once effect + deterministic-replay durability layer for Vercel AI SDK agents. Drop-in: generateText -> runDurable.",
  "keywords": [
    "ai",
    "agent",
    "llm",
    "typescript",
    "ai-sdk",
    "durable",
    "exactly-once",
    "journal",
    "replay",
    "idempotency",
    "crash-recovery"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite-storage.d.ts",
      "default": "./dist/sqlite-storage.js"
    },
    "./postgres": {
      "types": "./dist/postgres-storage.d.ts",
      "default": "./dist/postgres-storage.js"
    },
    "./redis": {
      "types": "./dist/redis-storage.d.ts",
      "default": "./dist/redis-storage.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@gnldev/tool-schema": "workspace:^",
    "ai": "^7.0.0",
    "ioredis": "^5.4.0",
    "pg": "^8.0.0",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "peerDependenciesMeta": {
    "@gnldev/tool-schema": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.0",
    "@ai-sdk/provider": "^4.0.0",
    "@gnldev/tool-schema": "workspace:*",
    "@gnldev/workflow": "workspace:*",
    "ai": "^7.0.0",
    "ioredis": "^5.4.0",
    "pg": "^8.0.0",
    "pg-mem": "^3.0.14",
    "zod": "^3.25.0"
  },
  "dependencies": {
    "superjson": "^2.2.6"
  },
  "author": "Karaca Yılmaz (https://gnl.dev)",
  "homepage": "https://gnl.dev",
  "bugs": {
    "url": "https://github.com/Karaca7/gnl-framework/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Karaca7/gnl-framework.git",
    "directory": "packages/durable"
  },
  "publishConfig": {
    "access": "public"
  }
}
