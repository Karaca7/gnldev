{
  "name": "@gnl/otel",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "description": "OpenTelemetry trace exporter for @gnl/durable. Journal → OTEL spans (deterministic ids = idempotent, crash-proof, exactly-once observability).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./live": {
      "types": "./dist/live.d.ts",
      "default": "./dist/live.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.28.0"
  },
  "peerDependencies": {
    "@gnl/durable": "workspace:^",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "ai": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/provider": "^2.0.0",
    "@gnl/durable": "workspace:*",
    "ai": "^5.0.0",
    "zod": "^3.25.0"
  }
}
