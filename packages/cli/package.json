{
  "name": "@gnldev/cli",
  "version": "0.4.1",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "gnl developer CLI: scaffold (init), hot-reload dev server (REST + Studio Playground), studio.",
  "keywords": [
    "ai",
    "agent",
    "llm",
    "typescript",
    "ai-sdk",
    "durable",
    "exactly-once",
    "scaffolding",
    "devtools"
  ],
  "type": "module",
  "bin": {
    "gnl": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dev": {
      "types": "./dist/dev.d.ts",
      "default": "./dist/dev.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "dev": [
        "./dist/dev.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "templates",
    "!templates/**/node_modules"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "tsx": "^4.19.0"
  },
  "peerDependencies": {
    "@gnldev/auth": "workspace:^",
    "@gnldev/durable": "workspace:^",
    "@gnldev/memory": "workspace:^",
    "@gnldev/server": "workspace:^",
    "@gnldev/studio": "workspace:^",
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "@gnldev/auth": {
      "optional": true
    },
    "@gnldev/durable": {
      "optional": true
    },
    "@gnldev/server": {
      "optional": true
    },
    "@gnldev/studio": {
      "optional": true
    },
    "@gnldev/memory": {
      "optional": true
    },
    "@hono/node-server": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@gnldev/auth": "workspace:^",
    "@gnldev/durable": "workspace:^",
    "@gnldev/memory": "workspace:^",
    "@gnldev/server": "workspace:^",
    "@gnldev/studio": "workspace:^",
    "@hono/node-server": "^1.19.17",
    "ai": "^7.0.0",
    "esbuild": "^0.21.5",
    "hono": "^4.13.2",
    "zod": "^3.25.0"
  },
  "author": "Karaca Yılmaz (https://gnl.dev)",
  "homepage": "https://gnl.dev",
  "bugs": {
    "url": "https://github.com/Karaca7/gnldev/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Karaca7/gnldev.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  }
}
