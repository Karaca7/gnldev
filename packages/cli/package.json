{
  "name": "@gnldev/cli",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "gnl developer CLI: scaffold (init), hot-reload dev server (REST + Studio Playground), studio.",
  "type": "module",
  "bin": {
    "gnl": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "tsx": "^4.19.0"
  },
  "peerDependencies": {
    "@gnldev/auth": "workspace:^",
    "@gnldev/durable": "workspace:^",
    "@gnldev/server": "workspace:^",
    "@gnldev/studio": "workspace:^",
    "@gnldev/memory": "workspace:^",
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "@gnldev/auth": {
      "optional": true
    },
    "@gnldev/durable": {
      "optional": true
    },
    "@gnldev/server": {
      "optional": true
    },
    "@gnldev/studio": {
      "optional": true
    },
    "@gnldev/memory": {
      "optional": true
    },
    "@hono/node-server": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@gnldev/auth": "workspace:^",
    "@gnldev/durable": "workspace:^",
    "@gnldev/server": "workspace:^",
    "@gnldev/studio": "workspace:^",
    "@gnldev/memory": "workspace:^",
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "ai": "^5.0.0",
    "zod": "^3.25.0",
    "esbuild": "^0.21.5"
  },
  "author": "Karaca7 (https://gnl.dev)",
  "homepage": "https://gnl.dev",
  "bugs": {
    "url": "https://github.com/Karaca7/gnl-framework/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Karaca7/gnl-framework.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  }
}
