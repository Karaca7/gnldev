{
  "name": "@gnldev/server",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "description": "Auto-REST + OpenAPI for @gnldev/durable agents: createGnl registry → HTTP router (run/resume/runs + openapi.json).",
  "keywords": [
    "ai",
    "agent",
    "llm",
    "typescript",
    "ai-sdk",
    "durable",
    "exactly-once",
    "rest",
    "hono",
    "openapi",
    "fetch-handler"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gnldev/auth": "workspace:^",
    "@gnldev/workflow": "workspace:^",
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0"
  },
  "peerDependencies": {
    "@gnldev/durable": "workspace:^"
  },
  "devDependencies": {
    "@gnldev/durable": "workspace:*",
    "ai": "^5.0.0",
    "zod": "^3.25.0"
  },
  "author": "Karaca Yılmaz (https://gnl.dev)",
  "homepage": "https://gnl.dev",
  "bugs": {
    "url": "https://github.com/Karaca7/gnl-framework/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Karaca7/gnl-framework.git",
    "directory": "packages/server"
  },
  "publishConfig": {
    "access": "public"
  }
}
