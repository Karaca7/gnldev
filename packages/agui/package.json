{
  "name": "@gnldev/agui",
  "version": "0.6.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "AG-UI (CopilotKit) protocol adapter: converts @gnldev/server SSE contract to AG-UI event sequences + Hono endpoint factory.",
  "keywords": [
    "ai",
    "agent",
    "llm",
    "typescript",
    "ai-sdk",
    "durable",
    "exactly-once",
    "ag-ui",
    "copilotkit"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gnldev/server": "workspace:^",
    "hono": "^4.13.2"
  },
  "peerDependencies": {
    "@gnldev/durable": "workspace:^"
  },
  "devDependencies": {
    "@gnldev/durable": "workspace:*",
    "ai": "^7.0.0",
    "zod": "^3.25.0"
  },
  "author": "Karaca Yılmaz (https://gnl.dev)",
  "homepage": "https://gnl.dev",
  "bugs": {
    "url": "https://github.com/Karaca7/gnldev/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Karaca7/gnldev.git",
    "directory": "packages/agui"
  },
  "publishConfig": {
    "access": "public"
  }
}
