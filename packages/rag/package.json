{
  "name": "@gnldev/rag",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "Vector store + RAG tool for AI SDK agents. Used as a tool, it becomes replayable/exactly-once RAG with @gnldev/durable.",
  "keywords": [
    "ai",
    "agent",
    "llm",
    "typescript",
    "ai-sdk",
    "durable",
    "exactly-once",
    "retrieval",
    "embeddings",
    "vector-search"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres-vector-store.d.ts",
      "default": "./dist/postgres-vector-store.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@gnldev/durable": "workspace:^",
    "ai": "^7.0.0",
    "pg": "^8.0.0",
    "zod": "^3.25.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@gnldev/durable": "workspace:*",
    "ai": "^7.0.0",
    "pg": "^8.0.0",
    "zod": "^3.25.0"
  },
  "author": "Karaca Yılmaz (https://gnl.dev)",
  "homepage": "https://gnl.dev",
  "bugs": {
    "url": "https://github.com/Karaca7/gnl-framework/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Karaca7/gnl-framework.git",
    "directory": "packages/rag"
  },
  "publishConfig": {
    "access": "public"
  }
}
