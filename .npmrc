# In-workspace scaffolds (gnl init / create-gnl) declare their dependency with a semver range
# (@gnldev/*: ^0.0.0) — without this flag pnpm looks for them in the registry and installs BREAK
# before publish. When on: the package is linked if the range matches the workspace version;
# AFTER the npm release, users outside the monorepo get normal registry resolution (this file
# does not affect them).
link-workspace-packages=true
