# Workspace içi scaffold'lar (gnl init / create-gnl) semver aralığıyla (@gnl/*: ^0.0.0) bağımlılık
# bildirir — bu bayrak olmadan pnpm bunları registry'de arar ve yayın öncesi kurulum KIRILIR.
# Açıkken: aralık workspace'teki sürümle eşleşiyorsa paket link'lenir; npm yayını SONRASI
# monorepo dışı kullanıcılar normal registry çözümlemesi alır (bu dosya onları etkilemez).
link-workspace-packages=true
