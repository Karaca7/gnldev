{
  "name": "gnl-framework",
  "private": true,
  "type": "module",
  "description": "gnl \u2014 a durable execution substrate for AI agents (monorepo)",
  "scripts": {
    "build": "pnpm -r build",
    "pretest": "node scripts/check-dist-fresh.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "check:docs": "node scripts/check-doc-samples.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "check:real": "node scripts/check-real-backends.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "license": "Apache-2.0",
  "pnpm": {
    "overrides": {
      "fast-uri": ">=3.1.5 <4",
      "ip-address": ">=10.3.1 <11",
      "protobufjs": ">=7.6.5 <8"
    }
  }
}
